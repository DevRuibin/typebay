{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typebay",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "typebay.projectbay.uk", "custom_domain": true }
  ]
}
